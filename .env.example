# Optional: Compose works with these defaults without copying this file.
# 8000 is reserved by Windows on some Docker/Hyper-V installations.
API_PORT=18000
WEB_PORT=18080
FALKORDB_PORT=6379
FALKORDB_HOST=127.0.0.1
FALKORDB_GRAPH=rippleproof
FALKORDB_CONNECT_TIMEOUT_S=2
FALKORDB_SOCKET_TIMEOUT_S=5
FALKORDB_QUERY_TIMEOUT_MS=3000

# Phase 3: disabled by default. Generate a secret locally; never commit it.
RIPPLEPROOF_APPROVAL_SECRET=
RIPPLEPROOF_PROVIDER=disabled
RIPPLEPROOF_ALLOW_PAID_CALLS=false
RIPPLEPROOF_OPENAI_API_KEY=
RIPPLEPROOF_OPENAI_MODEL=
